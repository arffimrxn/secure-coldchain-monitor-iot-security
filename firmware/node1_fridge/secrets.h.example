// secrets.h.example — copy to secrets.h (same folder) and fill in real values.
// secrets.h must be git-ignored. NEVER commit real credentials, certificates or keys.
#pragma once

// Wi-Fi (2.4 GHz only)
#define WIFI_SSID   "your-wifi-name"
#define WIFI_PASS   "your-wifi-password"

// MQTT broker on the gateway
#define MQTT_HOST   "192.168.x.x"     // the gateway's IP on the same network as the ESP32
#define MQTT_PORT   1883              // Stage 6 baseline only; becomes 8883 (mutual TLS) at Stage 9

// Device identity (= certificate CN = MQTT username from Stage 9)
#define DEVICE_ID   "sensor01"
#define TOPIC_TELEMETRY "campus/sensor01/telemetry"
#define TOPIC_CMD       "campus/sensor01/cmd"

// Stage 9 (mutual TLS): CA, client certificate and key go in secrets.h only, never here.
// #define BROKER_TLS_NAME "gw.grp3.lab"   // verify the broker certificate by DNS name
// const char* CA_CERT     = R"(-----BEGIN CERTIFICATE----- ... )";
// const char* CLIENT_CERT = R"(-----BEGIN CERTIFICATE----- ... )";
