// secrets.h.example — COPY to secrets.h and fill in real values.
// secrets.h is git-ignored. NEVER commit real credentials or keys.
#pragma once

// Wi-Fi
#define WIFI_SSID   "your-wifi-name"
#define WIFI_PASS   "your-wifi-password"

// MQTT broker (Raspberry Pi gateway)
#define MQTT_HOST   "192.168.1.50"   // Pi gateway IP
#define MQTT_PORT   1883             // baseline; becomes 8883 (MQTTS) after hardening
#define MQTT_USER   "node1"          // set once broker auth is enabled
#define MQTT_PASS   "change-me"

// Device identity
#define DEVICE_ID   "sensor01"
#define MQTT_TOPIC  "campus/fridge/sensor01"

