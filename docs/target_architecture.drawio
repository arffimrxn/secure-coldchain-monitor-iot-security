        <mxCell id="e1l" value="MQTTS 8883" style="text;html=1;fontSize=9;fontColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="283" y="215" width="80" height="16" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F6368;" edge="1" parent="1" source="pi" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3l" value="HTTPS + cert (M8)" style="text;html=1;fontSize=9;fontColor=#7B2FB5;" vertex="1" parent="1"><mxGeometry x="562" y="200" width="100" height="16" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F6368;" edge="1" parent="1" source="backend" target="clinic"><mxGeometry relative="1" as="geometry" /></mxCell>
